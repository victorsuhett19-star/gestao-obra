// Prisma schema — Sistema de Gestão de Obra (turn-key)
// SQLite em desenvolvimento; troque o provider para "postgresql" em produção.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Empresa / Usuários
// ---------------------------------------------------------------------------

model Empresa {
  id        String   @id @default(cuid())
  nome      String
  criadoEm  DateTime @default(now())

  usuarios     Usuario[]
  obras        Obra[]
  fornecedores Fornecedor[]
  materiais    Material[]
  etapaTemplates EtapaTemplate[]
  colaboradores  Colaborador[]
  atendimentos   Atendimento[]
  eventos        Evento[]
  acessos        UsuarioEmpresa[]
  contasFinanceiras ContaFinanceira[]
}

// Acesso extra de um usuário a outras empresas além da sua "empresa principal"
// (Usuario.empresaId). Permite o seletor de empresa no menu lateral quando o
// mesmo usuário atende mais de uma empresa (ex: grupo com várias marcenarias).
model UsuarioEmpresa {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  @@unique([usuarioId, empresaId])
}

// Equipe de campo (montadores, conferentes etc.) — diferente de Usuario, que é
// quem loga no sistema. Um colaborador pode nunca acessar o app, só aparecer
// marcado como presente no diário de obra.
model Colaborador {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  nome       String
  funcao     String?
  telefone   String?
  fotoUrl    String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  presencas  DiarioColaborador[]
  montagens  RegistroMontagem[]  @relation("MontagemMontador")
  registrosPonto RegistroPonto[]
  folgas         FolgaFerias[]
  folhas         FolhaPagamento[]
  documentos     DocumentoColaborador[]
}

enum PapelUsuario {
  ADMIN
  GESTOR
  ENGENHEIRO
  MESTRE_OBRA
}

model Usuario {
  id         String       @id @default(cuid())
  empresaId  String
  empresa    Empresa      @relation(fields: [empresaId], references: [id])
  nome       String
  email      String       @unique
  senhaHash  String
  papel      PapelUsuario @default(GESTOR)
  ativo      Boolean      @default(true)
  criadoEm   DateTime     @default(now())
  // Lista de módulos (chaves de MODULOS em src/lib/permissoes.ts) separados por
  // vírgula que este usuário pode visualizar. null = sem restrição customizada
  // ainda (comportamento antigo: vê tudo). ADMIN sempre vê tudo, ignora este campo.
  modulosVisiveis String?

  obrasCriadas       Obra[]              @relation("ObraCriadaPor")
  etapasResponsavel  Etapa[]             @relation("EtapaResponsavel")
  lancamentos        LancamentoFinanceiro[] @relation("LancamentoCriadoPor")
  pedidosMaterial    PedidoMaterial[]    @relation("PedidoCriadoPor")
  fotosEnviadas      Foto[]              @relation("FotoEnviadaPor")
  diariosCriados     DiarioObra[]        @relation("DiarioCriadoPor")
  itensConferencia   ItemConferencia[]   @relation("ItemConferenciaResponsavel")
  vistoriasResponsavel VistoriaFinal[]   @relation("VistoriaResponsavel")
  atendimentosVendedor Atendimento[]     @relation("AtendimentoVendedor")
  eventosCriados       Evento[]          @relation("EventoCriadoPor")
  acessosEmpresa       UsuarioEmpresa[]
}

// ---------------------------------------------------------------------------
// Obra
// ---------------------------------------------------------------------------

enum StatusObra {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum Trade {
  MARCENARIA
  OBRA
  PROJETO
  MARMORARIA
  VIDRACARIA
}

model Obra {
  id                   String     @id @default(cuid())
  empresaId            String
  empresa              Empresa    @relation(fields: [empresaId], references: [id])
  nome                 String
  endereco             String?
  clienteNome          String?
  clienteTelefone      String?
  clienteEmail         String?
  clienteCpfCnpj       String?
  descricao            String?
  condicoesPagamento   String?
  prazoExecucaoDias    Int?
  status               StatusObra @default(PLANEJAMENTO)
  dataInicioPrevista   DateTime?
  dataFimPrevista      DateTime?
  dataInicioReal       DateTime?
  dataFimReal          DateTime?
  criadoPorId          String?
  criadoPor            Usuario?   @relation("ObraCriadaPor", fields: [criadoPorId], references: [id])
  criadoEm             DateTime   @default(now())

  trades               ObraTrade[]
  etapas               Etapa[]
  itensOrcamento       ItemOrcamento[]
  lancamentos          LancamentoFinanceiro[]
  pedidosMaterial      PedidoMaterial[]
  fotos                Foto[]
  diarios              DiarioObra[]
  objetivos            ObjetivoDiario[]
  itensConferencia     ItemConferencia[]
  registrosMontagem    RegistroMontagem[]
  vistoriasFinal       VistoriaFinal[]
  atendimentoOrigem    Atendimento?
  eventos              Evento[]
  contasFinanceiras    ContaFinanceira[]
}

model ObraTrade {
  id      String @id @default(cuid())
  obraId  String
  obra    Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)
  trade   Trade

  @@unique([obraId, trade])
}

// ---------------------------------------------------------------------------
// Cronograma (EAP)
// ---------------------------------------------------------------------------

model EtapaTemplate {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  trade      Trade
  nome       String
  ordem      Int      @default(0)
  paiId      String?
  pai        EtapaTemplate?  @relation("EtapaTemplateFilhos", fields: [paiId], references: [id])
  filhos     EtapaTemplate[] @relation("EtapaTemplateFilhos")
}

enum StatusEtapa {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
}

model Etapa {
  id                  String      @id @default(cuid())
  obraId              String
  obra                Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  paiId               String?
  pai                 Etapa?      @relation("EtapaFilhos", fields: [paiId], references: [id])
  filhos              Etapa[]     @relation("EtapaFilhos")
  nome                String
  ordem               Int         @default(0)
  dataInicioPrevista  DateTime?
  dataFimPrevista     DateTime?
  dataInicioReal      DateTime?
  dataFimReal         DateTime?
  percentualConcluido Int         @default(0)
  status              StatusEtapa @default(NAO_INICIADA)
  responsavelId       String?
  responsavel         Usuario?    @relation("EtapaResponsavel", fields: [responsavelId], references: [id])
  criadoEm            DateTime    @default(now())

  itensOrcamento      ItemOrcamento[]
  fotos               Foto[]
}

// ---------------------------------------------------------------------------
// Orçamento & financeiro
// ---------------------------------------------------------------------------

enum CategoriaOrcamento {
  MATERIAL
  MAO_DE_OBRA
  SERVICO
  EQUIPAMENTO
  OUTROS
}

model ItemOrcamento {
  id             String             @id @default(cuid())
  obraId         String
  obra           Obra               @relation(fields: [obraId], references: [id], onDelete: Cascade)
  etapaId        String?
  etapa          Etapa?             @relation(fields: [etapaId], references: [id])
  categoria      CategoriaOrcamento @default(OUTROS)
  descricao      String
  unidade        String?
  quantidade     Float              @default(1)
  valorUnitario  Float              @default(0)
  valorTotal     Float              @default(0)
  criadoEm       DateTime           @default(now())

  lancamentos    LancamentoFinanceiro[]
}

enum TipoLancamento {
  CUSTO
  RECEITA
  PAGAMENTO
}

model LancamentoFinanceiro {
  id              String          @id @default(cuid())
  obraId          String
  obra            Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  itemOrcamentoId String?
  itemOrcamento   ItemOrcamento?  @relation(fields: [itemOrcamentoId], references: [id])
  tipo            TipoLancamento  @default(CUSTO)
  categoria       String?
  descricao       String
  valor           Float
  data            DateTime        @default(now())
  formaPagamento  String?
  comprovanteUrl  String?
  criadoPorId     String?
  criadoPor       Usuario?        @relation("LancamentoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm        DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Materiais & fornecedores
// ---------------------------------------------------------------------------

model Fornecedor {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  nome         String
  cnpjCpf      String?
  contato      String?
  telefone     String?
  email        String?
  especialidade String?
  criadoEm     DateTime @default(now())

  pedidos      PedidoMaterial[]
  contasFinanceiras ContaFinanceira[]
}

model Material {
  id              String   @id @default(cuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  nome            String
  unidade         String
  categoria       String?
  precoReferencia Float?
  criadoEm        DateTime @default(now())

  itensPedido     ItemPedidoMaterial[]
}

enum StatusPedido {
  RASCUNHO
  ENVIADO
  CONFIRMADO
  ENTREGUE
  CANCELADO
}

model PedidoMaterial {
  id                    String       @id @default(cuid())
  obraId                String
  obra                  Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  fornecedorId          String
  fornecedor            Fornecedor   @relation(fields: [fornecedorId], references: [id])
  status                StatusPedido @default(RASCUNHO)
  dataPedido            DateTime     @default(now())
  dataEntregaPrevista   DateTime?
  dataEntregaReal       DateTime?
  valorTotal            Float        @default(0)
  criadoPorId           String?
  criadoPor             Usuario?     @relation("PedidoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm              DateTime     @default(now())

  itens                 ItemPedidoMaterial[]
}

model ItemPedidoMaterial {
  id             String         @id @default(cuid())
  pedidoId       String
  pedido         PedidoMaterial @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material       @relation(fields: [materialId], references: [id])
  quantidade     Float
  valorUnitario  Float
  valorTotal     Float
}

// ---------------------------------------------------------------------------
// Fotos & diário de obra
// ---------------------------------------------------------------------------

model Foto {
  id           String      @id @default(cuid())
  obraId       String
  obra         Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  etapaId      String?
  etapa        Etapa?      @relation(fields: [etapaId], references: [id])
  diarioId     String?
  diario       DiarioObra? @relation(fields: [diarioId], references: [id])
  url          String
  legenda      String?
  dataFoto     DateTime    @default(now())
  enviadoPorId String?
  enviadoPor   Usuario?    @relation("FotoEnviadaPor", fields: [enviadoPorId], references: [id])
  criadoEm     DateTime    @default(now())
}

enum Clima {
  ENSOLARADO
  NUBLADO
  CHUVOSO
  IMPRATICAVEL
}

// Lista leve de objetivos/pendências da obra (não presa a um dia específico,
// fica visível como "objetivos de hoje" até ser marcada como concluída).
model ObjetivoDiario {
  id          String   @id @default(cuid())
  obraId      String
  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  descricao   String
  concluido   Boolean  @default(false)
  criadoEm    DateTime @default(now())
}

model DiarioObra {
  id                   String   @id @default(cuid())
  obraId               String
  obra                 Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  data                 DateTime @default(now())
  clima                Clima?
  terceirizados        String?
  atividadesRealizadas String
  necessidades         String?
  criadoPorId          String?
  criadoPor            Usuario? @relation("DiarioCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm             DateTime @default(now())

  fotos                Foto[]
  colaboradores        DiarioColaborador[]
}

// Join table: quais colaboradores estiveram presentes em cada registro de diário.
model DiarioColaborador {
  id             String      @id @default(cuid())
  diarioId       String
  diario         DiarioObra  @relation(fields: [diarioId], references: [id], onDelete: Cascade)
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id])

  @@unique([diarioId, colaboradorId])
}

// ---------------------------------------------------------------------------
// Conferência (funil de medidas/projeto) — inspirado no fluxo de conferência
// de marcenaria: cada ambiente/item passa por etapas de verificação antes de
// seguir para produção/montagem.
// ---------------------------------------------------------------------------

enum StatusConferencia {
  VENDA_FUTURA
  CONFERENCIA_MEDIDAS
  AJUSTE_PROJETO
  CONFERENCIA_PROJETOS
  DESENHO_PROJETOS
  CONCLUIDO
}

model ItemConferencia {
  id             String            @id @default(cuid())
  obraId         String
  obra           Obra              @relation(fields: [obraId], references: [id], onDelete: Cascade)
  titulo         String
  status         StatusConferencia @default(VENDA_FUTURA)
  responsavelId  String?
  responsavel    Usuario?          @relation("ItemConferenciaResponsavel", fields: [responsavelId], references: [id])
  prazo          DateTime?
  observacoes    String?
  criadoEm       DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Montagem — registro de montagem por obra: ambientes/valores de contrato,
// itens extras comprados por fora e faltas de fábrica antecipadas. A equipe
// só deveria iniciar a montagem quando itens extras e faltas de fábrica
// estiverem marcados como recebidos (checagem feita na UI).
// ---------------------------------------------------------------------------

enum StatusMontagem {
  FILA
  EM_ANDAMENTO
  CONCLUIDA
}

model RegistroMontagem {
  id            String         @id @default(cuid())
  obraId        String
  obra          Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  dataChegada   DateTime?
  status        StatusMontagem @default(FILA)
  valorTotal    Float          @default(0)
  montadorId    String?
  montador      Colaborador?   @relation("MontagemMontador", fields: [montadorId], references: [id])
  observacoes   String?
  criadoEm      DateTime       @default(now())

  ambientes     AmbienteMontagem[]
  itensExtras   ItemExtraMontagem[]
  faltasFabrica FaltaFabricaMontagem[]
}

model AmbienteMontagem {
  id            String           @id @default(cuid())
  registroId    String
  registro      RegistroMontagem @relation(fields: [registroId], references: [id], onDelete: Cascade)
  nome          String
  numeroPedido  String?
  notaFiscal    String?
  qtdVolumes    Int?
  valor         Float            @default(0)
}

model ItemExtraMontagem {
  id           String           @id @default(cuid())
  registroId   String
  registro     RegistroMontagem @relation(fields: [registroId], references: [id], onDelete: Cascade)
  descricao    String
  quantidade   Int              @default(1)
  recebido     Boolean          @default(false)
}

model FaltaFabricaMontagem {
  id            String           @id @default(cuid())
  registroId    String
  registro      RegistroMontagem @relation(fields: [registroId], references: [id], onDelete: Cascade)
  numeroPedido  String?
  numeroVolume  String?
  recebido      Boolean          @default(false)
}

// ---------------------------------------------------------------------------
// Vistoria Final — relatório de supervisão por ambiente, com assinatura do
// responsável e do cliente confirmando a conclusão (ou registrando ocorrência).
// ---------------------------------------------------------------------------

enum StatusItemVistoria {
  PENDENTE
  CONCLUIDO_SEM_OCORRENCIA
  CONCLUIDO_COM_OCORRENCIA
}

model VistoriaFinal {
  id                     String    @id @default(cuid())
  obraId                 String
  obra                   Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  dataVistoria           DateTime  @default(now())
  responsavelId          String?
  responsavel            Usuario?  @relation("VistoriaResponsavel", fields: [responsavelId], references: [id])
  observacoesCliente     String?
  assinadoResponsavelEm  DateTime?
  assinadoClienteEm      DateTime?
  criadoEm               DateTime  @default(now())

  itens                  ItemVistoria[]
}

model ItemVistoria {
  id          String             @id @default(cuid())
  vistoriaId  String
  vistoria    VistoriaFinal      @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
  ambiente    String
  status      StatusItemVistoria @default(PENDENTE)
  observacao  String?
}

// ---------------------------------------------------------------------------
// Atendimento (CRM / funil de vendas) — leads e clientes potenciais antes de
// virarem uma Obra contratada. Ao fechar negócio, o atendimento é convertido
// em Obra (link 1:1 opcional via obraId).
// ---------------------------------------------------------------------------

enum OrigemAtendimento {
  LEAD
  CLIENTE_DE_PORTA
  JA_CLIENTE
  INDICACAO
}

enum StatusAtendimento {
  ENTRADA_LEADS
  CONTATO_REALIZADO
  PROPOSTA_ENVIADA
  NEGOCIACAO
  GANHO
  PERDIDO
}

model Atendimento {
  id                String            @id @default(cuid())
  empresaId         String
  empresa           Empresa           @relation(fields: [empresaId], references: [id])
  nomeCliente       String
  telefone          String?
  email             String?
  ambienteDesejado  String?
  origem            OrigemAtendimento @default(LEAD)
  vendedorId        String?
  vendedor          Usuario?          @relation("AtendimentoVendedor", fields: [vendedorId], references: [id])
  status            StatusAtendimento @default(ENTRADA_LEADS)
  valorEstimado     Float?
  motivoPerda       String?
  obraId            String?           @unique
  obra              Obra?             @relation(fields: [obraId], references: [id])
  criadoEm          DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Agenda — eventos simples da equipe (reuniões, visitas etc.), podendo se
// referir a uma obra específica.
// ---------------------------------------------------------------------------

enum TipoEvento {
  REUNIAO
  VISITA
  ENTREGA
  OUTRO
}

model Evento {
  id          String     @id @default(cuid())
  empresaId   String
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  titulo      String
  tipo        TipoEvento @default(REUNIAO)
  data        DateTime
  obraId      String?
  obra        Obra?      @relation(fields: [obraId], references: [id])
  criadoPorId String?
  criadoPor   Usuario?   @relation("EventoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm    DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// RH — ponto, férias/folgas e folha de pagamento dos colaboradores (equipe
// de campo). Pasta do funcionário guarda documentos avulsos (contrato, RG...).
// ---------------------------------------------------------------------------

enum TipoRegistroPonto {
  TRABALHO
  FALTA
  ATESTADO
  FERIADO
  FOLGA
}

model RegistroPonto {
  id            String            @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador       @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  data          DateTime
  tipo          TipoRegistroPonto @default(TRABALHO)
  horaEntrada   String?
  horaSaida     String?
  observacao    String?
  criadoEm      DateTime          @default(now())

  @@unique([colaboradorId, data])
}

enum TipoFolga {
  FERIAS
  FOLGA
}

enum StatusFolga {
  SOLICITADA
  APROVADA
  RECUSADA
}

model FolgaFerias {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoFolga   @default(FOLGA)
  dataInicio    DateTime
  dataFim       DateTime
  status        StatusFolga @default(SOLICITADA)
  observacao    String?
  criadoEm      DateTime    @default(now())
}

enum StatusFolha {
  PENDENTE
  PAGA
}

model FolhaPagamento {
  id             String      @id @default(cuid())
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  mesReferencia  String
  salarioBase    Float
  descontos      Float       @default(0)
  valorLiquido   Float
  status         StatusFolha @default(PENDENTE)
  pagoEm         DateTime?
  criadoEm       DateTime    @default(now())

  @@unique([colaboradorId, mesReferencia])
}

model DocumentoColaborador {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  nome          String
  url           String
  criadoEm      DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Financeiro da empresa (contas a pagar/receber) — alimenta o DRE junto com
// os LancamentoFinanceiro de cada obra. Diferente do financeiro por obra
// (previsto x realizado), este é o financeiro "de casa": aluguel, salários,
// recebimentos de clientes fora do fluxo de uma obra específica etc.
// ---------------------------------------------------------------------------

enum TipoContaFinanceira {
  PAGAR
  RECEBER
}

enum StatusContaFinanceira {
  PENDENTE
  PAGO
}

model ContaFinanceira {
  id              String                @id @default(cuid())
  empresaId       String
  empresa         Empresa               @relation(fields: [empresaId], references: [id])
  tipo            TipoContaFinanceira
  descricao       String
  categoria       String?
  valor           Float
  dataVencimento  DateTime
  dataPagamento   DateTime?
  status          StatusContaFinanceira @default(PENDENTE)
  fornecedorId    String?
  fornecedor      Fornecedor?           @relation(fields: [fornecedorId], references: [id])
  obraId          String?
  obra            Obra?                 @relation(fields: [obraId], references: [id])
  criadoEm        DateTime              @default(now())
}
